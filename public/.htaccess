# ============================================================================
#  ES Ynanch Hyzmat — конфигурация Apache
#
#  Хостинг:  GoDaddy Web Hosting (Linux, cPanel)
#  Сборка:   Vite 8, многостраничный сайт
#
#  КУДА КЛАСТЬ ФАЙЛ:
#    В проекте — public/.htaccess
#    Vite копирует содержимое public/ в dist/ как есть, поэтому файл
#    сам окажется в корне сайта при каждой сборке. Руками копировать
#    его на хостинг не нужно.
#
#  ВАЖНО ПРИ УПАКОВКЕ:
#    Стандартный архиватор Windows и Finder пропускают файлы, чьё имя
#    начинается с точки. Архивируйте из терминала:
#        cd dist && zip -r ../site.zip . -x ".DS_Store"
#    И проверяйте:
#        unzip -l site.zip | grep htaccess
#
#  ЕСЛИ ПОСЛЕ ЗАЛИВКИ САЙТ ОТДАЁТ 500:
#    Виноват этот файл. Переименуйте его в htaccess.txt — если сайт ожил,
#    закомментируйте блоки по одному снизу вверх. Чаще всего на дешёвых
#    тарифах запрещена директива Options (блок 7).
# ============================================================================


# ============================================================================
#  1. КОДИРОВКА
# ============================================================================

AddDefaultCharset UTF-8


# ============================================================================
#  2. MIME-ТИПЫ  ← САМЫЙ ВАЖНЫЙ БЛОК ДЛЯ ВАШЕГО СЛУЧАЯ
#
#  Apache на GoDaddy настроен консервативно и не знает про AVIF.
#  Без этих строк сервер отдаёт .avif как application/octet-stream:
#  в DevTools будет статус 200 OK, но картинка не отобразится.
#  Симптом — пустой hero при отсутствии ошибок в консоли.
#
#  Это первое, что нужно проверять, если изображения не видны.
# ============================================================================

<IfModule mod_mime.c>
  AddType image/avif                .avif
  AddType image/avif-sequence       .avifs
  AddType image/webp                .webp
  AddType font/woff2                .woff2
  AddType image/svg+xml             .svg
  AddType application/manifest+json .webmanifest
</IfModule>


# ============================================================================
#  3. КЭШИРОВАНИЕ
#
#  У вас ДВА типа статики, и им нужны РАЗНЫЕ сроки:
#
#  ┌─────────────────────────┬──────────────┬─────────────────────────────┐
#  │ Откуда                  │ Имя в dist   │ Можно ли кэшировать надолго │
#  ├─────────────────────────┼──────────────┼─────────────────────────────┤
#  │ src/assets/images/main/ │ slide-2-Xk9…│ ДА — хэш меняется вместе    │
#  │ (обычные слайды)        │ .avif        │ с содержимым, URL новый     │
#  ├─────────────────────────┼──────────────┼─────────────────────────────┤
#  │ public/img/hero/        │ hero-night   │ НЕТ — имя стабильное,       │
#  │ (тематические день/ночь)│ .avif        │ замена не дойдёт до людей   │
#  └─────────────────────────┴──────────────┴─────────────────────────────┘
#
#  ХЭШ САМ ПО СЕБЕ НИЧЕГО НЕ КЭШИРУЕТ. Он лишь даёт ПРАВО на вечный кэш,
#  а воспользоваться правом должен заголовок. Без Cache-Control браузер
#  применит эвристику: возьмёт Last-Modified и закэширует примерно на 10%
#  от возраста файла. Свежезалитый файл → срок почти нулевой → при каждом
#  визите летят условные запросы с ответом 304. Тела нет, но круговая
#  задержка есть: 20 ассетов × 100 мс на мобильной сети ≈ 2 секунды впустую.
#
#  ПОРЯДОК ПРАВИЛ ВАЖЕН. При нескольких совпадениях FilesMatch директива
#  Header set ЗАМЕНЯЕТ значение, то есть выигрывает ПОСЛЕДНЕЕ сработавшее
#  правило. Поэтому блок про тематические картинки стоит В КОНЦЕ — так он
#  гарантированно перебьёт всё остальное, даже если наборы когда-нибудь
#  начнут пересекаться.
# ============================================================================

<IfModule mod_headers.c>

  # ---- 3.1 HTML: всегда переспрашивать сервер -----------------------------
  #
  # no-cache НЕ запрещает кэширование, вопреки названию. Он требует
  # ревалидации перед каждым использованием. Браузер шлёт условный запрос,
  # сервер отвечает 304 без тела — быстро, и обновления сайта доходят сразу.
  #
  # no-store (не используем) означал бы «не хранить вообще» — каждый визит
  # качал бы HTML целиком, медленнее без всякой пользы.

  <FilesMatch "\.(html|htm)$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>


  # ---- 3.2 Всё, что собрал Vite: имена с хэшем ----------------------------
  #
  # Ловит имена вида  name-BOWI1PpB.js  /  slide-2-CzS-PmOu.avif
  # Регулярка: дефис, затем ровно 8 символов из [A-Za-z0-9_-], затем точка
  # и расширение. Ровно такой формат Vite 8 даёт по умолчанию.
  #
  # Сюда попадают JS, CSS И обычные слайды из src/assets/images/main —
  # отдельного правила для них не нужно, они той же природы.
  #
  # immutable добавлен не для красоты: без него браузер при нажатии F5
  # всё равно перепроверит каждый ресурс и получит пачку 304-х. immutable
  # означает «файл не изменится никогда, не спрашивай даже при перезагрузке».
  # Для хэшированных имён это правда по построению.

  <FilesMatch "-[a-zA-Z0-9_-]{8}\.(js|css|avif|webp|jpe?g|png|svg|woff2)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>


  # ---- 3.3 Шрифты ---------------------------------------------------------
  #
  # Если подключаете шрифт локально (Poppins и т.п.). Файл шрифта не меняется
  # годами, поэтому год и immutable.

  <FilesMatch "\.(woff2|woff|ttf|otf)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>


  # ---- 3.4 Статика без хэша из public/ ------------------------------------
  #
  # favicon, иконки, манифест. Месяц — разумный компромисс: достаточно долго,
  # чтобы не перекачивать, достаточно коротко, чтобы замена дошла.

  <FilesMatch "\.(gif|svg|ico|webmanifest)$">
    Header set Cache-Control "public, max-age=2592000"
  </FilesMatch>


  # ---- 3.5 ТЕМАТИЧЕСКИЕ КАРТИНКИ (день/ночь) ------------------------------
  #
  # СТОИТ ПОСЛЕДНИМ НАМЕРЕННО — перебивает все правила выше.
  #
  # Эти файлы лежат в public/img/hero/ и хэша НЕ имеют. Так сделано потому,
  # что пути к ним живут в data-srcset (Vite не переписывает произвольные
  # data-атрибуты), а инлайн-скрипт в <head> собирает путь для preload
  # строкой на лету — хэш ему неоткуда взять.
  #
  # Неделя вместо года — плата за это. Префиксное совпадение ^hero-(day|night)
  # поймает и версионированные имена: hero-night-v2.avif.
  #
  # stale-while-revalidate=86400: сутки после истечения срока браузер может
  # мгновенно отдать старую версию, подтягивая свежую фоном. Пользователь
  # не ждёт.
  #
  # ⚠ ПРИ ЗАМЕНЕ ФОТОГРАФИИ меняйте ИМЯ файла (hero-night-v2.avif),
  #   иначе неделю часть посетителей будет видеть прежнее фото.
  #   Имя правится в ТРЁХ местах index.html:
  #     1) data-srcset у <source>
  #     2) data-src у <img>
  #     3) инлайн-скрипт в <head>, строка сборки l.href

  <FilesMatch "^hero-(day|night)">
    Header set Cache-Control "public, max-age=604800, stale-while-revalidate=86400"
  </FilesMatch>


  # ---- 3.6 Заголовки безопасности -----------------------------------------
  #
  # nosniff  — запрещает браузеру угадывать тип файла вопреки Content-Type.
  # SAMEORIGIN — запрещает встраивать сайт в <iframe> на чужих доменах.
  #              Уберите, если планируете где-то встраивать сайт сами.
  # Referrer-Policy — не передавать полный URL при переходах на чужие сайты.

  Header set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header set Referrer-Policy "strict-origin-when-cross-origin"

  # HSTS. Включайте ТОЛЬКО когда убедились, что HTTPS работает стабильно.
  # После включения браузер полгода будет отказываться открывать сайт
  # по HTTP — откатить быстро не получится.
  # Header always set Strict-Transport-Security "max-age=15552000"

</IfModule>


# ============================================================================
#  4. СЖАТИЕ
#
#  Картинки в список НЕ включены намеренно. AVIF, WebP и JPEG уже сжаты
#  своими алгоритмами; gzip поверх них жжёт процессор, а размер иногда
#  даже увеличивает.
#
#  Ваш main.css (~21 КБ) ужмётся примерно до 6 КБ, main.js (~99 КБ) — до 30 КБ.
# ============================================================================

# Brotli — если доступен, сжимает лучше gzip примерно на 15–20%
<IfModule mod_brotli.c>
  AddOutputFilterByType BROTLI_COMPRESS text/html text/css text/plain text/xml
  AddOutputFilterByType BROTLI_COMPRESS application/javascript application/json
  AddOutputFilterByType BROTLI_COMPRESS image/svg+xml
</IfModule>

# gzip — есть практически везде, работает как запасной вариант
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml
  AddOutputFilterByType DEFLATE application/javascript application/json
  AddOutputFilterByType DEFLATE image/svg+xml
  AddOutputFilterByType DEFLATE font/woff font/ttf
</IfModule>


# ============================================================================
#  5. ПРИНУДИТЕЛЬНЫЙ HTTPS
#
#  ВТОРОЕ УСЛОВИЕ ОБЯЗАТЕЛЬНО. GoDaddy держит перед Apache прокси-слой,
#  и переменная %{HTTPS} внутри Apache может показывать off даже тогда,
#  когда пользователь пришёл по HTTPS. Без проверки X-Forwarded-Proto
#  получите бесконечный цикл редиректов и сайт перестанет открываться.
#
#  Закомментируйте весь блок, если SSL-сертификат ещё не выпущен:
#  GoDaddy выдаёт бесплатный не мгновенно, иногда через несколько часов.
# ============================================================================

<IfModule mod_rewrite.c>
  RewriteEngine On

  RewriteCond %{HTTPS} off
  RewriteCond %{HTTP:X-Forwarded-Proto} !https
  RewriteRule ^(.*)$ https://%{HTTP_HOST}/$1 [R=301,L]

  # --- Необязательно: ссылки без .html ---
  # Позволит открывать /about вместо /about.html.
  # Раскомментируйте, если захотите короткие адреса. Учтите, что старые
  # ссылки с .html продолжат работать, и поисковик увидит две версии —
  # тогда стоит добавить canonical в разметку страниц.
  #
  # RewriteCond %{REQUEST_FILENAME} !-f
  # RewriteCond %{REQUEST_FILENAME} !-d
  # RewriteCond %{REQUEST_FILENAME}.html -f
  # RewriteRule ^(.*)$ $1.html [L]
</IfModule>


# ============================================================================
#  6. ЗАЩИТА СЛУЖЕБНЫХ ФАЙЛОВ
#
#  Apache обычно закрывает .ht* сам, но на общем хостинге лучше
#  не полагаться на чужие настройки.
# ============================================================================

<FilesMatch "^\.(htaccess|htpasswd|env|git)">
  Require all denied
</FilesMatch>

# Файлы, которые не должны попасть на прод, но могут случайно уехать
<FilesMatch "(package\.json|package-lock\.json|vite\.config\.js|\.map)$">
  Require all denied
</FilesMatch>


# ============================================================================
#  7. ПРОЧЕЕ
#
#  ⚠ ЕСЛИ САЙТ ОТДАЁТ 500 — начните отладку с этой строки.
#    На части тарифов GoDaddy директива Options запрещена настройкой
#    AllowOverride, и её наличие роняет сервер.
# ============================================================================

Options -Indexes

DirectoryIndex index.html

# Страница 404 — раскомментируйте, когда создадите 404.html
# ErrorDocument 404 /404.html
